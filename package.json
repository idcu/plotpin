{
  "name": "plotpin",
  "version": "0.2.0",
  "description": "图钉 PlotPin — 离线、零依赖、双击即用的通用图纸标注工具",
  "private": true,
  "scripts": {
    "test": "node scripts/check-ngm.mjs && node scripts/selftest.mjs",
    "check:ngm": "node scripts/check-ngm.mjs",
    "lint": "node scripts/check.mjs",
    "contracts": "node scripts/check-contracts.mjs",
    "contracts:selftest": "node scripts/check-contracts.mjs --selftest",
    "api": "node scripts/check-plugin-api.mjs",
    "api:selftest": "node scripts/check-plugin-api.mjs --selftest",
    "badge": "node scripts/badge.mjs",
    "bench": "node scripts/bench.mjs",
    "build": "node scripts/build.mjs",
    "ci": "node scripts/check.mjs --selftest && node scripts/bench.mjs && node scripts/build.mjs --check && node scripts/check-gates.mjs",
    "gates": "node scripts/check-gates.mjs",
    "discipline": "node scripts/check-discipline.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "perf:browser": "node scripts/perf-browser.mjs"
  },
  "keywords": [
    "canvas",
    "offline",
    "annotation",
    "drawing",
    "blueprint",
    "zero-dependency",
    "cad",
    "site-plan"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.65.0"
  }
}
