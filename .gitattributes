# 统一文本文件换行符为 LF（浏览器与 Node 在 Windows 上同样兼容 LF）
* text=auto eol=lf

# 二进制资源
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.bmp binary
*.ico binary
*.xlsx binary
*.zip binary
# DXF 导出使用 CRLF，golden 必须逐字节保留（不得做换行归一）
*.dxf -text

# 台账 CSV/TSV golden 使用 CRLF，必须逐字节保留（IO-P2-2）
tests/golden/*.csv -text
tests/golden/*.tsv -text
